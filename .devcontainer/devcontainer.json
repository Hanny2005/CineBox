{
  "name": "CineBox (Laravel 12)",
  "image": "mcr.microsoft.com/devcontainers/php:8.4",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "CineBox", "onAutoForward": "openBrowser" }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postAttachCommand": "php artisan serve --host=0.0.0.0 --port=8000",
  "customizations": {
    "vscode": {
      "extensions": ["bmewburn.vscode-intelephense-client", "onecentlab.laravel-blade-snippets"]
    }
  }
}
